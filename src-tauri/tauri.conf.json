{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BYOC FinOps Auditor",
  "version": "0.1.0",
  "identifier": "com.byoc.finops.auditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BYOC FinOps & Shadow AI Auditor",
        "width": 1240,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ]
  }
}